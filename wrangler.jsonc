{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration-schema.json",
  "name": "lenny-simpson",
  "compatibility_date": "2025-11-01",
  // Static site (Astro `dist/` output) deployed as a Worker with assets.
  // This makes `npx wrangler deploy` work, which is also what Cloudflare runs
  // when a wrangler.jsonc is present. Build first: `npm run build`.
  // Alternative (dashboard Pages flow): build command `npm run build`, output `dist/`.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
  }
}
