---
interface Props {
  title?: string;
  description?: string;
}
const { title = 'LennySimpson — Build & Play', description = 'Lenny’s hobby page: Three.js games, builds, and experiments.' } = Astro.props;
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href="/">🚀 Lenny<span>Simpson</span></a>
        <nav class="links">
          <a href="/cross-the-swamp" aria-current={current === '/cross-the-swamp' ? 'page' : undefined}>🐸 Swamp</a>
          <a href="/game" aria-current={current === '/game' ? 'page' : undefined}>⭐ Stars</a>
          <a href="/blog" aria-current={current.startsWith('/blog') ? 'page' : undefined}>📝 Blog</a>
          <a href="/about" aria-current={current === '/about' ? 'page' : undefined}>👋 About</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer>
      <div class="wrap">
        Built with Dad 💛 · Astro + Three.js · Hosted on Cloudflare Pages · <a href="/rss.xml">RSS</a>
      </div>
    </footer>
  </body>
</html>
